# Logs
*.log
# Private object storage (local development provider). The provider refuses
# roots inside the repository; this is a second guard against committing objects.
.heroos-storage/
private-objects/

# Database backup artifacts (contain database data). The tooling refuses to
# write inside the repository; this is a second guard.
*.dump
*.pgdump
*.backup
backups/

# Private rule bundles (workflow progression content, M2-03). They belong in
# server-side storage only, never in this repository; this is a second guard
# (docs/architecture/workflow-progression.md). Name private bundles
# *.private-bundle.json.
*.private-bundle.json
private-rule-bundles/

# Private document templates (M2-04C): template bundles, the mapping files and
# review packs of the offline converter, and the source Word documents. None of
# them may ever be committed (the repository is public); this is a second guard
# (docs/architecture/document-templates.md). Name private template bundles
# *.private-templates.json and mappings *.private-mapping.json.
*.private-templates.json
*.private-mapping.json
private-template-bundles/
template-review-packs/
*.docx
*.docm
*.dotx
*.dotm
*.doc
