# HeroOS local environment template.
# Never place real credentials in this file.

# Required, no default: development | staging | production.
# The API refuses to start if it is missing.
HEROOS_ENV=development

# The web app's settings (API base URL, Cognito, session secret) are server-only
# and live in apps/web/.env.local; see apps/web/.env.example. No API URL or
# identity setting is ever inlined into browser JavaScript (no NEXT_PUBLIC_*).

# Local PostgreSQL development database (docs/operations/database-credentials.md).
# Never type or commit database passwords: `make env-init` copies this file to
# the untracked root .env (mode 0600) and generates every value left empty below.
# `make env-check` validates .env without printing values. There are no
# built-in defaults: empty values stop Docker Compose, Alembic and the API.
#
# Staging and production credentials must come from secure environment configuration
# (AWS Secrets Manager; not yet provisioned). Outside development the API refuses to
# start unless DATABASE_URL is set explicitly to a non-local host, and it
# refuses MIGRATION_DATABASE_URL entirely (the API never holds the admin role).
#
# Docker Compose: password of the migration/admin role `heroos` (POSTGRES_PASSWORD)
# and of the API runtime role `heroos_app` (the api container's DATABASE_URL).
HEROOS_DB_ADMIN_PASSWORD=
HEROOS_DB_APP_PASSWORD=
# Host tooling. DATABASE_URL is the API runtime role: not superuser, no
# BYPASSRLS, owns no tables, so PostgreSQL Row-Level Security applies. The API
# refuses to start with a privileged role. Create/update it with `make db-runtime-role`.
DATABASE_URL=
# Migration/admin role that owns the schema. Used by Alembic only, never the API.
MIGRATION_DATABASE_URL=

# Authentication (see docs/architecture/authentication.md).
# development | cognito | oidc. Unset means every protected request is rejected.
# The development provider is refused at startup unless HEROOS_ENV=development;
# staging requires cognito or oidc; production requires cognito.
HEROOS_AUTH_PROVIDER=development

# LOCAL DEVELOPMENT ONLY. Signs local dev bearer tokens (`make dev-token
# SUBJECT=...`), so anyone holding it can mint tokens: generated by
# `make env-init`, never committed. Staging and production refuse to start if
# this variable is set at all.
HEROOS_DEV_AUTH_SECRET=

# Browser origins allowed to call the API cross-origin, comma-separated exact
# origins (https://host[:port]; http://localhost only in development). Unset (the
# default) sends no CORS headers. The web app calls the API from its server, so
# the demo deployment leaves this unset.
# HEROOS_CORS_ALLOWED_ORIGINS=

# Founder self-registration (POST /company-registrations, M1-10C). Off unless
# set to true, in every environment; enabling it is an activation step
# (docs/operations/company-registration.md §3).
# HEROOS_SELF_REGISTRATION_ENABLED=false

# Hannah AI demo (conversational, fictional scenarios only; GroqCloud). Off
# unless set to true, refused in production; then every Company administrator
# can use it in their own Company's Cases. Usage ceilings live in the API
# process's memory (per account per 5 minutes; whole service per minute and per
# day). GROQ_API_KEY is a secret: set it in the host's environment, never here.
# See docs/architecture/hannah-ai-demo.md.
# HEROOS_HANNAH_DEMO_ENABLED=false
# HEROOS_HANNAH_MODEL=openai/gpt-oss-120b
# HEROOS_HANNAH_ACCOUNT_LIMIT=20
# HEROOS_HANNAH_GLOBAL_LIMIT_PER_MINUTE=20
# HEROOS_HANNAH_GLOBAL_LIMIT_PER_DAY=900
# GROQ_API_KEY=

# Ask HeroOS's controlled AI conversation gateway (M2-NEW-05). Off unless set to
# true; then active only when every prerequisite holds: provider and model (server
# configuration only), GROQ_API_KEY, an installed knowledge bundle, and the
# reference of HeroOS's approval of this deployment's AI configuration. A
# development (or synthetic) bundle also needs ALLOW_DEVELOPMENT_KNOWLEDGE, which
# production refuses. Real customer data needs the open AI privacy decisions
# first. Limits count founder turns (each up to four provider requests).
# See docs/architecture/ai-gateway.md.
# HEROOS_AI_GATEWAY_ENABLED=false
# HEROOS_AI_GATEWAY_PROVIDER=groq
# HEROOS_AI_GATEWAY_MODEL=openai/gpt-oss-120b
# HEROOS_AI_GATEWAY_APPROVAL=
# HEROOS_AI_GATEWAY_ALLOW_DEVELOPMENT_KNOWLEDGE=false
# HEROOS_AI_GATEWAY_ACCOUNT_LIMIT=10
# HEROOS_AI_GATEWAY_GLOBAL_LIMIT_PER_MINUTE=6
# HEROOS_AI_GATEWAY_GLOBAL_LIMIT_PER_DAY=300
# Local development and automated tests never call a real AI provider (they get
# an offline stand-in), whatever the settings above say. A deliberate local live
# smoke test opts in explicitly; production refuses it.
# HEROOS_AI_LIVE_SMOKE_ENABLED=false

# Ask HeroOS's deterministic conversation evaluation (M2-NEW-06): the private
# execution profile approving which knowledge, definition, rule bundle and
# Condition bindings operate together (a JSON file and its SHA-256, set both or
# neither), and the shared secret that encrypts the trusted state a conversation
# carries between turns (base64url or hex of at least 32 random bytes; the same
# value on every API instance; required with a profile). Unset: the checks are
# unavailable and say so; nothing else changes. Production refuses a synthetic
# or development profile. The key is a secret: set it in the host's environment.
# See docs/architecture/conversation-evaluation.md.
# HEROOS_EXECUTION_PROFILE_PATH=
# HEROOS_EXECUTION_PROFILE_SHA256=
# HEROOS_EVALUATION_CONTINUATION_KEY=

# Provider-neutral OIDC access-token verification (development and staging only;
# production is Cognito-only). Required when HEROOS_AUTH_PROVIDER=oidc.
# Never commit real values here. See docs/architecture/authentication.md §4.3.
# HEROOS_OIDC_ISSUER=https://<issuer-exactly-as-in-discovery>/
# HEROOS_OIDC_AUDIENCE=<HeroOS API identifier; must differ from the client ID>
# Required: client IDs allowed to obtain tokens (comma-separated).
# HEROOS_OIDC_CLIENT_IDS=
# Optional: JWKS override (only if keys are not on the issuer's origin), algorithms, profile.
# HEROOS_OIDC_JWKS_URI=
# HEROOS_OIDC_ALGORITHMS=RS256,ES256
# HEROOS_OIDC_REQUIRE_RFC9068=true

# Amazon Cognito access-token verification (deployed environments; no pool exists yet).
# Required when HEROOS_AUTH_PROVIDER=cognito. Never commit real values here.
# HEROOS_COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
# HEROOS_COGNITO_APP_CLIENT_ID=<app-client-id>
# Optional; defaults to <issuer>/.well-known/jwks.json
# HEROOS_COGNITO_JWKS_URI=
# Optional resource-server identifier. When set, access tokens must carry a
# matching `aud`; when unset, `aud` is not checked.
# HEROOS_COGNITO_RESOURCE_AUDIENCE=

# Private object storage (see docs/architecture/private-object-storage.md).
# local | s3. Unset means no object storage: every object operation is refused.
# `local` is development only and refused in staging/production. `s3` is the
# production contract and stops startup until its adapter exists.
# HEROOS_STORAGE_PROVIDER=local
# Required for `local`: an ABSOLUTE path outside the repository and outside any
# web-served directory. Created with 0700 directories and 0600 files.
# HEROOS_LOCAL_STORAGE_ROOT=/absolute/path/outside/the/repository/heroos-private-objects
