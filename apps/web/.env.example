# HeroOS web app environment template (server-only settings).
# Never place real values in this file. For local runs copy it to
# apps/web/.env.local (ignored by Git); deployed values are set in the hosting
# platform's environment settings. See docs/operations/demo-authentication-deployment.md.
#
# None of these variables is prefixed NEXT_PUBLIC_, so none is inlined into
# browser JavaScript. Missing or invalid values make sign-in report
# "not configured" (fail closed); the variable names, never values, are checked.

# Exact public origin of this web app (https; http://localhost only outside production).
# The OAuth redirect URI is <origin>/auth/callback and the sign-out URL is <origin>/.
HEROOS_WEB_ORIGIN=

# Cognito managed-login origin, https only, no path:
# https://<domain-prefix>.auth.<region>.amazoncognito.com
HEROOS_COGNITO_DOMAIN=
# Public App Client ID (Authorization Code + PKCE; the client has no secret).
HEROOS_COGNITO_CLIENT_ID=

# HeroOS API base URL (https, no trailing slash). Called only from the web server.
HEROOS_API_BASE_URL=

# The Company the demo shows. The API still requires a Membership for it.
HEROOS_DEMO_COMPANY_ID=

# SECRET. Encrypts the session and login cookies (AES-256-GCM).
# 64 lowercase hex characters, e.g. `openssl rand -hex 32`. Rotating it signs
# everyone out.
HEROOS_WEB_SESSION_SECRET=
