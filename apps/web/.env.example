# HeroOS web app environment template (server-only settings).
# Never place real values in this file. For local runs copy it to
# apps/web/.env.local (ignored by Git); deployed values are set in the hosting
# platform's environment settings. See docs/operations/demo-authentication-deployment.md.
#
# None of these variables is prefixed NEXT_PUBLIC_, so none is inlined into
# browser JavaScript. Missing or invalid values make sign-in report
# "not configured" (fail closed); the variable names, never values, are checked.

# Exact public origin of this web app (https; http://localhost only outside production).
# The OAuth redirect URI is <origin>/auth/callback and the sign-out URL is <origin>/.
HEROOS_WEB_ORIGIN=

# Identity provider: oidc (pre-M5 demo, any OpenID Provider) | cognito (M5).
HEROOS_WEB_AUTH_PROVIDER=

# --- oidc ---------------------------------------------------------------------
# Issuer exactly as in the provider's discovery document (https; a trailing
# slash, if the provider uses one, is significant). Endpoints are discovered from
# <issuer>/.well-known/openid-configuration.
HEROOS_OIDC_ISSUER=
# Public client ID (Authorization Code + PKCE; the client has no secret).
HEROOS_OIDC_CLIENT_ID=
# HeroOS API identifier requested as `audience`; must differ from the client ID.
HEROOS_OIDC_AUDIENCE=

# --- cognito (M5) -------------------------------------------------------------
# Managed-login origin, https only, no path:
# https://<domain-prefix>.auth.<region>.amazoncognito.com
HEROOS_COGNITO_DOMAIN=
HEROOS_COGNITO_CLIENT_ID=

# --- common -------------------------------------------------------------------
# HeroOS API base URL (https, no trailing slash). Called only from the web server.
HEROOS_API_BASE_URL=

# Candidate demo Companies: comma-separated lowercase UUIDs, no spaces, distinct,
# at most 5. The web asks the API about each one and lists only those the API
# authorizes for the signed-in user; the list itself grants nothing. When this is
# unset or empty, the legacy single HEROOS_DEMO_COMPANY_ID below is used.
HEROOS_DEMO_COMPANY_IDS=

# Legacy single candidate (one lowercase UUID); ignored when HEROOS_DEMO_COMPANY_IDS
# is set. One of the two variables is required.
HEROOS_DEMO_COMPANY_ID=

# SECRET. Encrypts the session and login cookies (AES-256-GCM).
# 64 lowercase hex characters, e.g. `openssl rand -hex 32`. Rotating it signs
# everyone out.
HEROOS_WEB_SESSION_SECRET=
